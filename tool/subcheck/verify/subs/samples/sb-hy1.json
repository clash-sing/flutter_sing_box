{
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "https",
        "server": "1.1.1.1"
      },
      {
        "tag": "local",
        "type": "https",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "provider-marker.example"
        ],
        "action": "route",
        "server": "local"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "tag": "节点选择",
      "type": "selector",
      "outbounds": [
        "自动选择",
        "TJ-A",
        "TJ-B",
        "HY1"
      ]
    },
    {
      "tag": "自动选择",
      "type": "urltest",
      "outbounds": [
        "TJ-A",
        "TJ-B",
        "HY1"
      ]
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "TJ-A",
      "type": "trojan",
      "server": "t1.example.com",
      "server_port": 443,
      "password": "pw",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "t1.example.com"
      }
    },
    {
      "tag": "TJ-B",
      "type": "trojan",
      "server": "t2.example.com",
      "server_port": 443,
      "password": "pw",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "t2.example.com"
      }
    },
    {
      "server": "y1.example.com",
      "server_port": 443,
      "tag": "HY1",
      "tls": {
        "enabled": true,
        "insecure": false,
        "server_name": "y1.example.com"
      },
      "up_mbps": 30,
      "down_mbps": 100,
      "type": "hysteria",
      "auth_str": "pw",
      "disable_mtu_discovery": true
    }
  ],
  "route": {
    "rules": [
      {
        "domain_suffix": [
          "provider-marker.example"
        ],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "节点选择",
    "default_domain_resolver": "local"
  }
}
